{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    ".agents/agents.md",
    ".cursor/docs/inject-snapshot.json"
  ],
  "agent": {
    "build": {
      "prompt": "Follow AGENTS.md and .agents/agents.md. Read .cursor/docs/inject-snapshot.json at the start of each turn. Writable paths: .cursor/** and .agents/state/** only unless the user asks for README/AGENTS edits."
    }
  }
}
